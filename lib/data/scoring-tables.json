  {
    "event_key": "sit_rise",
    "display_name": "Sitting-Rising Test (SRT)",
    "input_unit": "number of supports used (counted separately for sitting and rising)",
    "gender_split": false,
    "age_split": false,
    "scoring_method": "two_part_sum",
    "scoring_description": "Apply the lookup once for sitting (number of supports used to lower to floor) and once for rising (number of supports used to stand up). Total score = sitting_points + rising_points. Max = 5 + 5 = 10. Deduct 0.5 pts for unsteadiness in either direction (applied before lookup). Supports counted: hands, knees, side of leg, forearm, etc. — each counts as 1.",
    "breakpoints": [
      {"threshold": "a", "points": 0},
      {"threshold": "z", "points": 0},
      {"threshold": 0, "points": 5},
      {"threshold": 1, "points": 4},
      {"threshold": 2, "points": 3},
      {"threshold": 3, "points": 2},
      {"threshold": 4, "points": 1}
    ],
    "notes": "Two non-numeric sentinels: 'a' = invalid/blank input (0 pts); 'z' = unable to complete the movement (0 pts). The display shows '4 or more supports = 1 pt'; the lookup only has threshold 4→1, so 5+ supports also returns 1 pt via VLOOKUP approximate match."
  },
